context-map {
  dependency desktop on board {
    map board/Board -> desktop/BoardView
  }
  dependency desktop on tournament {
    map tournament/Match -> desktop/MatchView
  }
  dependency terminal on board {
    map board/Board -> terminal/BoardView
  }
  dependency terminal on tournament {
    map tournament/Match -> terminal/MatchView
  }
  dependency tournament on board {
    map board/Board -> tournament/RoundResult
  }
}
